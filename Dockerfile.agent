FROM python:3.12-slim

WORKDIR /app

# git: clones the target repo. docker-cli: talks to the host docker daemon via
# the mounted socket (see docker-compose.yml `agent` service) — no daemon runs
# in this container, just the client. This container is a stronger trust
# boundary than the ingest worker; keep it opt-in (compose profile "agent").
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev git docker-cli \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY packages/ packages/
COPY apps/ apps/

ENV PYTHONPATH=/app/packages:/app/apps:/app/apps/dashboard
