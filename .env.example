# Copy to .env for docker compose
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=flakyradar
POSTGRES_USER=flakyradar
POSTGRES_PASSWORD=flakyradar
REDIS_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1

# AI layer (root-cause classification, RAG suggestions, diagnostic agent)
# leave the API keys unset to skip AI analysis

# LLM provider — default is Anthropic (Claude). Also used by AGENT_MAX_STEPS'
# diagnostic agent (packages/core/agent.py).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set LLM_PROVIDER=openai-compatible to call any OpenAI-compatible endpoint
# instead (OpenAI, Azure OpenAI, OpenRouter, Groq, self-hosted Ollama/vLLM, ...):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Embedding provider — default is Voyage AI.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Set EMBEDDING_PROVIDER=openai-compatible to call any OpenAI-compatible
# embeddings endpoint instead:
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
