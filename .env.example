# Copy to .env for docker compose
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=flakyradar
POSTGRES_USER=flakyradar
POSTGRES_PASSWORD=flakyradar
REDIS_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1

# AI layer (root-cause classification) — leave unset to skip AI analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
